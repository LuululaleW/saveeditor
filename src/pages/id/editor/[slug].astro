---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditorApp from '../../../components/EditorApp';

export async function getStaticPaths() {
  const engines = [
    {
      slug: 'rpg-maker-mv',
      name: 'RPG Maker MV/MZ',
      fileType: '.rpgsave, .rmmzsave',
      title: 'Editor Simpanan RPG Maker Online - Edit .rpgsave dan .rmmzsave Gratis',
      description:
        'Editor simpanan RPG Maker gratis. Edit file .rpgsave (MV) dan .rmmzsave (MZ) secara online. Modifikasi emas, statistik, item, sakelar, dan variabel. Tanpa unduhan.',
      keywords:
        'rpg maker save editor, editor simpanan rpg, rpgsave editor, edit .rpgsave online, rpg maker mv save editor, rpg maker mz save editor, rmmzsave editor',
      features: [
        'Edit Emas / Uang',
        'Modifikasi Statistik (Level, EXP, HP, MP)',
        'Buka Item dan Senjata',
        'Edit Variabel dan Sakelar Game',
      ],
      instructions: [
        'Temukan file simpanan Anda (biasanya di `www/save/` di dalam folder game)',
        'Unggah file `file1.rpgsave` di atas',
        'Edit emas, statistik, dan variabel Anda',
        'Unduh file yang telah dimodifikasi dan ganti yang asli',
      ],
    },
    {
      slug: 'unity',
      name: 'Unity',
      fileType: '.xml, .plist',
      title: 'Editor Simpanan Unity | Edit PlayerPrefs Online',
      description:
        'Editor simpanan Unity online gratis. Modifikasi Unity PlayerPrefs (.xml, .plist) untuk game Android, iOS, dan PC. Tanpa unduhan.',
      keywords: 'unity save editor, unity playerprefs editor, edit unity xml, unity plist editor',
      features: [
        'Edit Data PlayerPrefs',
        'Modifikasi Pengaturan Game',
        'Buka Level dan Pencapaian',
        'Dukungan Multiplatform (Android XML, iOS Plist)',
      ],
      instructions: [
        'Temukan file simpanan Unity Anda (sering kali di `AppData` atau folder game)',
        'Unggah file `.xml` atau `.plist`',
        'Modifikasi nilai di editor',
        'Unduh dan ganti file asli',
      ],
    },
    {
      slug: 'renpy',
      name: "Ren'Py",
      fileType: '.save',
      title: "Editor Simpanan Ren'Py Online - Edit File .save Gratis",
      description:
        "Editor simpanan Ren'Py gratis. Edit dan visualisasikan file .save secara online. Modifikasi variabel, bendera, dan progres cerita. Berfungsi dengan DDLC dan novel visual.",
      keywords:
        "renpy save editor, ren'py save editor, editor .save, memodifikasi file save renpy, ddlc save editor, editor novel visual",
      features: [
        "Lihat dan Edit Data Ren'Py",
        'Modifikasi Variabel dan Bendera',
        'Inspeksi Riwayat dan Waktu Bermain',
        'Hanya baca (penyimpanan eksperimental)',
      ],
      instructions: [
        "Temukan file simpanan Ren'Py Anda (biasanya di `game/saves/`)",
        'Unggah file `.save`',
        'Edit status game dan variabel',
        '⚠️ Catatan: Penyimpanan bersifat eksperimental dan dapat merusak file. Gunakan dengan risiko Anda sendiri.',
      ],
    },
    {
      slug: 'unreal',
      name: 'Unreal Engine',
      fileType: '.sav',
      title: 'Editor Simpanan Unreal Engine - Edit .sav Gratis | Palworld',
      description:
        'Editor web untuk `.sav` Unreal berdasarkan GVAS standar. Termasuk analisis, deteksi kompresi, dan rekonstruksi aman untuk wrapper yang kompatibel.',
      keywords:
        'unreal engine save editor, palworld save editor, editor .sav, editor file sav, gvas editor online, uesave editor',
      features: [
        'Parse GVAS standar (.sav)',
        'Deteksi kompresi zlib/gzip/raw-deflate',
        'Mode hanya baca untuk struktur yang tidak kompatibel',
        'Rekonstruksi aman untuk GVAS standar dan wrapper yang kompatibel',
      ],
      instructions: [
        'Temukan file `.sav` Anda di direktori simpanan game',
        'Unggah file ke editor',
        'Edit hanya bidang yang kompatibel saat analisis lengkap',
        'Untuk format kompleks per game, gunakan alat khusus.',
      ],
    },
    {
      slug: 'palworld',
      name: 'Palworld',
      fileType: '.sav',
      title: 'Editor Simpanan Palworld | Tampilan Aman GVAS',
      description:
        'Entri khusus untuk alur Palworld. Memprioritaskan inspeksi aman GVAS standar dan pengeditan dengan cadangan sebelumnya.',
      keywords:
        'editor palworld, palworld .sav, palworld gvas',
      features: [
        'Validasi format untuk `.sav` Steam',
        'Inspeksi terstruktur JSON GVAS',
        'Fallback otomatis ke hanya baca',
        'Tautan ke alat komunitas Palworld',
      ],
      instructions: [
        'Buat cadangan seluruh folder SaveGames sebelum mengedit',
        'Unggah file `.sav` pemain atau `Level.sav` Anda',
        'Periksa spanduk mode (dapat diedit vs hanya baca)',
        'Jika muncul tidak kompatibel, gunakan alat khusus Palworld',
      ],
    },
    {
      slug: 'gamemaker',
      name: 'GameMaker',
      fileType: '.ini, .json',
      title: 'Editor Simpanan GameMaker | Edit Simpanan INI dan JSON',
      description:
        'Editor universal untuk GameMaker. Modifikasi file .ini dan .json yang digunakan oleh game GameMaker Studio. Sederhana dan cepat.',
      keywords:
        'gamemaker save editor, edit simpanan gamemaker, undertale save editor, editor ini gamemaker',
      features: [
        'Edit File Konfigurasi INI',
        'Modifikasi Data JSON',
        'Fallback Teks Biasa untuk Format Khusus',
        'Kompatibel dengan GameMaker Studio 1 dan 2',
      ],
      instructions: [
        'Temukan file simpanan Anda (sering kali `save.ini` atau `save.json`)',
        'Unggah ke editor',
        'Ubah nilai seperti uang, kesehatan, atau item yang dibuka',
        'Simpan dan ganti file asli',
      ],
    },
    {
      slug: 'naninovel',
      name: 'NaniNovel',
      fileType: '.nson',
      title: 'Editor Simpanan NaniNovel | Edit File .nson',
      description:
        'Edit file simpanan novel visual NaniNovel (.nson) secara online. Modifikasi status game, bendera, dan variabel dengan mudah.',
      keywords: 'naninovel save editor, edit file .nson, editor novel visual',
      features: [
        'Parse File .nson',
        'Edit JSON Status Game',
        'Modifikasi Variabel Global',
        'Dukungan untuk Simpanan Terkompresi',
      ],
      instructions: [
        'Temukan file simpanan `.nson` Anda',
        'Unggah ke editor',
        'Modifikasi data JSON',
        'Unduh file yang diperbarui',
      ],
    },
  ];

  return engines.map((engine) => ({
    params: { slug: engine.slug },
    props: { engine },
  }));
}

const { engine } = Astro.props;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://saveeditor.top';
const absUrl = (path: string) =>
  new URL(path.endsWith('/') ? path : `${path}/`, siteOrigin).toString();
---

<BaseLayout title={engine.title} description={engine.description} keywords={engine.keywords}>
  <section class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/id/" class="hover:text-gray-900">Beranda</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg
                class="w-3 h-3 text-gray-400 mx-1"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 6 10"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="m1 9 4-4-4-4"></path>
              </svg>
              <span class="ml-1 text-gray-700 font-medium">{engine.name}</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">
          Editor {engine.name}
        </h1>
        <p class="text-lg text-gray-600">
          Unggah file <code class="bg-gray-100 px-2 py-1 rounded text-sm"
            >{engine.fileType}</code
          > untuk mulai mengedit.
        </p>
      </div>

      <!-- Interactive Editor App -->
      <div class="min-h-[400px]">
        <EditorApp client:only="react" acceptedFileTypes={engine.fileType} editorSlug={engine.slug} />
      </div>

      <div class="mt-16 prose prose-blue max-w-none">
        <h2>Cara menggunakan</h2>
        <ol>
          {
            engine.instructions.map((step) => (
              <li>
                <Fragment set:html={step.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))
          }
        </ol>

        <h2>Fitur</h2>
        <ul>
          {engine.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mt-12 not-prose">
        <h3 class="text-lg font-bold text-blue-900 mb-2">Butuh Bantuan?</h3>
        <p class="text-blue-700 mb-4">
          Lihat panduan terperinci kami untuk {engine.name}. (Panduan saat ini dalam Bahasa Inggris)
        </p>
        {
          (() => {
            const tutorialMap = {
              'rpg-maker-mv': '/blog/how-to-edit-rpg-maker-save',
              unity: '/blog/how-to-edit-unity-saves',
              unreal: '/blog/how-to-edit-unreal-engine-saves',
              palworld: '/blog/palworld-save-editing-guide',
              renpy: '/blog/renpy-save-editing-guide',
              naninovel: '/blog/naninovel-save-editing-guide',
              gamemaker: '/blog/gamemaker-save-editing-guide',
            } as const;
            const tutorialLink =
              tutorialMap[engine.slug as keyof typeof tutorialMap] ||
              '/blog/common-save-file-extensions-explained';

            return (
              <a
                href={tutorialLink}
                class="text-blue-600 font-medium hover:underline flex items-center gap-1"
              >
                Baca Tutorial Lengkap
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            );
          })()
        }
      </div>
    </div>
  </section>

  <!-- Schema.org Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: `${engine.name} Save Editor`,
      description: engine.description,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: engine.features,
      url: absUrl(`/id/editor/${engine.slug}`),
      author: {
        '@type': 'Organization',
        name: 'SaveEditor.Online',
        url: absUrl('/id/'),
      },
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: absUrl('/id/'),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${engine.name} Editor`,
          item: absUrl(`/id/editor/${engine.slug}`),
        },
      ],
    })}
  />
</BaseLayout>
